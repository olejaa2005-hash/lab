<!DOCTYPE html>
<html>
<head>
  <title>Lab</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Миттєве підключення Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="bg-gray-50 text-gray-900 min-h-screen">

<!-- Навігаційна панель -->
<header class="bg-white shadow-sm border-b border-gray-200 mb-8 p-4">
  <div class="max-w-5xl mx-auto flex justify-between items-center">
    <div>
      <strong class="text-xl text-blue-600 font-bold">Lab System</strong>
    </div>
    <div>
      <% if current_user %>
            <span class="mr-4 text-gray-600">
              Ви увійшли як: <span class="font-medium text-gray-900"><%= current_user.email_address %></span>
              (<%= current_user.role %>)
            </span>
        <%= button_to "Вийти", session_path, method: :delete, form: { class: 'inline-block' }, class: "text-red-600 font-medium hover:underline cursor-pointer bg-transparent border-none p-0" %>
      <% else %>
        <%= link_to "Увійти", new_session_path, class: "text-blue-600 font-medium hover:underline" %>
      <% end %>
    </div>
  </div>
</header>

<!-- Тут виводиться контент кожної сторінки -->
<main class="max-w-5xl mx-auto px-4">
  <!-- Блок для виводу повідомлень (notice/alert) -->
  <% if notice %>
    <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 border border-green-200"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"><%= alert %></div>
  <% end %>

  <%= yield %>
</main>

</body>
</html>