<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1>Перевірка роботи: <%= @template.title %></h1>
    <%= link_to "Назад до списку", teacher_lab_works_path, style: "color: blue; text-decoration: none;" %>
  </div>

  <p style="color: #666; margin-bottom: 20px;">Студент: <b><%= @lab_work.student.email_address %></b></p>

  <h2 style="font-size: 18px; margin-bottom: 15px;">Запитання та відповіді:</h2>

  <div style="display: flex; flex-direction: column; gap: 15px;">
    <% @template.questions.each_with_index do |question, index| %>
      <div style="padding: 15px; border: 1px solid #ccc; border-radius: 5px; background: #f9f9f9;">
        <p style="font-weight: bold; margin: 0 0 5px 0;"><%= index + 1 %>. <%= question.content %></p>
        <p style="margin: 0; color: #444; background: #fff; padding: 10px; border: 1px dashed #ddd;">[Тут згодом виводитиметься відповідь студента]</p>
      </div>
    <% end %>
  </div>

  <div style="margin-top: 30px; display: flex; gap: 10px;">
    <%= button_to "Позначити як перевірену", teacher_lab_work_path(@lab_work, status: "reviewed"), method: :patch, style: "padding: 10px 20px; background: green; color: white; border: none; font-weight: bold; cursor: pointer; border-radius: 4px;" %>
  </div>
</div>