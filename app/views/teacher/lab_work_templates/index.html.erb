<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1 style="margin: 0;">Кабінет викладача: Шаблони лабораторних</h1>
    <div>
      <%= link_to "Здані роботи", teacher_lab_works_path, style: "margin-right: 15px; padding: 8px 16px; background: green; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
      <%= button_to "Вийти", logout_path, method: :delete, style: "display: inline; padding: 8px 16px; background: red; color: white; border: none; cursor: pointer; border-radius: 4px;" %>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <%= link_to "Створити новий шаблон", new_teacher_lab_work_template_path, style: "padding: 8px 16px; background: blue; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
  </div>

  <div style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
    <% @templates.each do |template| %>
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee;">
        <div>
          <h3 style="margin: 0; color: blue;"><%= link_to template.title, teacher_lab_work_template_path(template), style: "text-decoration: none; color: blue;" %></h3>
          <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;"><%= truncate(template.description, length: 100) %></p>
        </div>
        <span style="background: #eee; padding: 4px 8px; border-radius: 4px; font-size: 12px;">Питань: <%= template.questions.count %></span>
      </div>
    <% end %>
    <% if @templates.empty? %>
      <p style="text-align: center; color: #666;">Щойно створених шаблонів ще немає.</p>
    <% end %>
  </div>
</div>