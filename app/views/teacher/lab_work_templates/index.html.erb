<div class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md border border-gray-200">
  <div class="flex justify-between items-center border-b pb-4 mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Мої шаблони лабораторних</h1>
    <div class="flex space-x-3">
      <%= link_to "📋 Призначити роботу", new_teacher_lab_work_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition" %>
      <%= link_to "+ Створити новий шаблон", new_teacher_lab_work_template_path, class: "px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition" %>
    </div>
  </div>

  <% if @templates.any? %>
    <ul class="space-y-4">
      <% @templates.each do |template| %>
        <li class="p-5 border border-gray-200 rounded-lg hover:shadow-sm transition">
          <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= template.title %></h3>
          <p class="text-gray-600 mb-4 line-clamp-2"><%= template.description %></p>

          <div class="flex items-center gap-4">
            <%= link_to "Переглянути", teacher_lab_work_template_path(template), class: "text-blue-600 font-medium hover:underline" %>
            <%= link_to "Редагувати", edit_teacher_lab_work_template_path(template), class: "text-yellow-600 font-medium hover:underline" %>

            <%= link_to "Призначити студенту", new_teacher_lab_work_path(template_id: template.id), class: "text-green-600 font-medium hover:underline" %>
            <%= button_to "Видалити", teacher_lab_work_template_path(template), method: :delete, class: "text-red-600 font-medium hover:underline bg-transparent border-none p-0 cursor-pointer" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 italic">У вас ще немає створених шаблонів.</p>
  <% end %>
</div>