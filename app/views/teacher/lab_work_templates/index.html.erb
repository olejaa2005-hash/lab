<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1>Мої шаблони лабораторних</h1>
    <div style="display: flex; gap: 10px;">
      <!-- Ось ця кнопка відкриває список зданих робіт студентів для перевірки -->
      <%= link_to "🔍 Перевірити здані роботи", teacher_lab_works_path, style: "padding: 8px 16px; background: #4f46e5; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
      <%= link_to "+ Створити новий шаблон", new_teacher_lab_work_template_path, style: "padding: 8px 16px; background: #10b981; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;" %>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 15px;">
    <% @lab_work_templates.each do |template| %>
      <div style="padding: 15px; border: 1px solid #ccc; border-radius: 5px; background: #fff; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="margin: 0 0 5px 0; color: #1d4ed8;"><%= template.title %></h3>
          <p style="margin: 0; color: #666; font-size: 14px;"><%= template.description %></p>
        </div>
        <div style="display: flex; gap: 10px;">
          <%= link_to "Переглянути", teacher_lab_work_template_path(template), style: "color: blue; text-decoration: none;" %>
          <%= link_to "Редагувати", edit_teacher_lab_work_template_path(template), style: "color: orange; text-decoration: none;" %>
          <%= link_to "Призначити студенту", new_teacher_lab_work_path(template_id: template.id), style: "color: green; text-decoration: none;" %>
          <%= button_to "Видалити", teacher_lab_work_template_path(template), method: :delete, data: { confirm: "Впевнені?" }, style: "background: none; border: none; color: red; cursor: pointer; padding: 0;" %>
        </div>
      </div>
    <% end %>
    <% if @lab_work_templates.empty? %>
      <p style="text-align: center; color: #666;">У вас ще немає створених шаблонів.</p>
    <% end %>
  </div>
</div>