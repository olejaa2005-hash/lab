<div class="max-w-3xl mx-auto mt-10 p-6 bg-white shadow-lg rounded-lg">
  <h1 class="text-2xl font-bold mb-6 text-gray-800">Створити новий шаблон лабораторної роботи</h1>

  <%= form_with model: [:teacher, @template], local: true, class: "space-y-6" do |form| %>
    <div>
      <%= form.label :title, "Назва лабораторної роботи", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :title, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2" %>
    </div>

    <div>
      <%= form.label :description, "Опис та інструкції", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border p-2" %>
    </div>

    <hr class="my-6">

    <h2 class="text-xl font-semibold text-gray-800">Питання до лабораторної</h2>

    <div id="questions" class="space-y-4">
      <%= form.fields_for :questions do |q_form| %>
        <div class="p-4 bg-gray-50 rounded-md border border-gray-200 space-y-3">
          <div>
            <%= q_form.label :content, "Текст питання", class: "block text-sm font-medium text-gray-700" %>
            <%= q_form.text_area :content, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2" %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= q_form.label :question_type, "Тип питання", class: "block text-sm font-medium text-gray-700" %>
              <%= q_form.select :question_type, [["Текст", "text"], ["Зображення", "image"], ["Код", "code"]], {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2" %>
            </div>

            <div class="flex items-center mt-6">
              <%= q_form.check_box :required, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
              <%= q_form.label :required, "Обов'язкове питання", class: "ml-2 block text-sm text-gray-900" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex justify-end space-x-4">
      <%= link_to "Скасувати", teacher_lab_work_templates_path, class: "px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400" %>
      <%= form.submit "Зберегти шаблон", class: "px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>
</div>