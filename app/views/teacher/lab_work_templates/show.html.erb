<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md border border-gray-200">
  <div class="border-b pb-4 mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= @template.title %></h1>

    <% if @template.description.present? %>
      <p class="text-gray-600 mt-2 text-lg"><%= @template.description %></p>
    <% end %>
  </div>

  <h3 class="text-xl font-semibold text-gray-800 mb-4">
    Питання (<%= @template.questions.count %>):
  </h3>

  <% if @template.questions.any? %>
    <ul class="space-y-3 mb-8">
      <% @template.questions.each_with_index do |question, index| %>
        <li class="p-4 bg-gray-50 rounded-md border border-gray-200">
          <span class="font-bold text-blue-600 mr-2"><%= index + 1 %>.</span>
          <span class="text-gray-700 text-lg"><%= question.content %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 italic mb-8">У цьому шаблоні ще немає питань.</p>
  <% end %>

  <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
    <%= link_to "✏️ Редагувати шаблон", edit_teacher_lab_work_template_path(@template), class: "px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition shadow-sm" %>
    <%= link_to "⬅️ Назад до списку", teacher_lab_work_templates_path, class: "px-5 py-2.5 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition border border-gray-300" %>
  </div>
</div>