<div class="flex items-center justify-center min-h-screen bg-gray-100">
  <div class="px-8 py-6 mt-4 text-left bg-white shadow-lg rounded-lg w-96">
    <h3 class="text-2xl font-bold text-center">Вхід на платформу «Lab»</h3>

    <%= form_with url: login_path, local: true do |form| %>
      <div class="mt-4">
        <div>
          <%= form.label :email_address, "Email", class: "block" %>
          <%= form.email_field :email_address, required: true, class: "w-full px-4 py-2 mt-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-blue-600" %>
        </div>
        <div class="mt-4">
          <%= form.label :password, "Пароль", class: "block" %>
          <%= form.password_field :password, required: true, class: "w-full px-4 py-2 mt-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-blue-600" %>
        </div>
        <div class="flex items-center justify-between mt-4">
          <%= form.submit "Увійти", class: "px-6 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-900" %>
        </div>
      </div>
    <% end %>
  </div>
</div>