<div style="max-width: 800px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1>Кабінет студента: Лабораторні роботи</h1>
    <%= button_to "Вийти", session_path, method: :delete, style: "padding: 8px 16px; background: red; color: white; border: none; cursor: pointer;" %>
  </div>

  <div>
    <h2>Мої лабораторні роботи</h2>
    <div style="border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
      <% if @lab_works.present? %>
        <% @lab_works.each do |work| %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee;">
            <div>
              <h3 style="margin: 0; color: blue;"><%= work.lab_work_template.title %></h3>
              <p style="margin: 5px 0 0 0; color: #666; font-size: 14px;"><%= work.lab_work_template.description %></p>
              <p style="margin: 5px 0 0 0; font-size: 12px; color: #666;">Статус: <b><%= work.status %></b></p>
            </div>
            <div>
              <%= link_to "Виконувати / Переглянути", student_lab_work_path(work), style: "padding: 8px 16px; background: blue; color: white; text-decoration: none; border-radius: 3px; font-weight: bold;" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p style="text-align: center; color: #666; padding: 20px;">Викладачі поки не призначили вам жодної лабораторної роботи.</p>
      <% end %>
    </div>
  </div>
</div>